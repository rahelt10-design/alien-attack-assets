// ==========================================
// ROOMS
// ==========================================

function getRoom(roomId) {
  if (!rooms.has(roomId)) {
    rooms.set(roomId, new Set());
  }

  return rooms.get(roomId);
}

function joinRoom(player, roomId) {
  const nextRoom = getRoom(roomId);

  if (
    nextRoom.size >= CONFIG.MAX_PLAYERS_PER_ROOM
  ) {
    return false;
  }

  if (player.room) {
    const oldRoom = rooms.get(player.room);

    if (oldRoom) {
      oldRoom.delete(player.id);

      if (oldRoom.size === 0) {
        rooms.delete(player.room);
      }
    }
  }

  player.room = roomId;
  nextRoom.add(player.id);

  return true;
}

function leaveRoom(player) {
  if (!player.room) return;

  const room = rooms.get(player.room);

  if (room) {
    room.delete(player.id);

    if (room.size === 0) {
      rooms.delete(player.room);
    }
  }

  player.room = null;
}

// ==========================================
// NETWORK SEND FUNCTIONS
// ==========================================

function send(socket, message) {
  if (
    socket &&
    socket.readyState === WebSocket.OPEN
  ) {
    socket.send(JSON.stringify(message));
  }
}

function sendToPlayer(playerId, message) {
  send(sockets.get(playerId), message);
}

function broadcastRoom(
  roomId,
  message,
  exceptId = null
) {
  const room = rooms.get(roomId);

  if (!room) return;

  const payload = JSON.stringify(message);

  for (const id of room) {
    if (id === exceptId) continue;

    const socket = sockets.get(id);

    if (
      socket &&
      socket.readyState === WebSocket.OPEN
    ) {
      socket.send(payload);
    }
  }
}

function sendError(player, code, message) {
  sendToPlayer(player.id, {
    type: "error",
    code,
    message
  });
}

